<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whatsapp All chats</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h3>All chats!</h3>
  
   <% for( chat of chats) { %>
          <div class="chat">
            <p>From: <i><%=chat.from%></i></p>
           <div class="msg">
             <p>msg: <%=chat.msg%></p>
              <form method="GET" action="/chats/<%=chat._id %>/edit">
            <button class="edit_message" data-id="<%=chat._id%>">edit message</button>

           </form>
           </div>
         
          
            <p>Received by: <i> <%=chat.to%></i></p>
            <form method="POST" action="/chats/<%=chat._id%>?_method=DELETE">
              <button id="delete">delete message</button>
            </form>
            <hr>
            <p><%=chat.created_at.toString().split(" ")[4]%></p>
            <p><%=chat.created_at.toString().split(" ").slice(0,4).join("-")%></p>
          </div>
       <br><br>
   <% } %>
       <form method="GET" action="/chats/new">
      <button id="createNew">Create new chat!</button>
    </form>
</body>
</html>

