<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>edit message</title>
  </head>
  <body>
    <h3>Edit your chat</h3>
    <p><%=chat._id%></p>
    <p>This chat was send from <i><%=chat.from%></i> to <i><%=chat.to%></i></p>
    <form method="POST" action="/chats/<%=chat._id%>?_method=PUT">
      <textarea name="msg" row="10" cols="20"><%=chat.msg%></textarea>
      <button>Edit</button>
    </form>
  </body>
</html>
